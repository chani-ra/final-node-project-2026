# EnglishWise Backend - example configuration only.
# Copy this file to .env, then replace placeholders with your own credentials.
# Never commit .env or any real credentials to GitHub.

# Application
NODE_ENV=development
PORT=3000

# Frontend URLs allowed to access the API (comma-separated, no trailing slash)
# Add the deployed frontend URL in Render's Environment settings, not here.
CLIENT_ORIGINS=http://localhost:5173

# Database (local example; MongoDB Atlas URI is also supported)
MONGODB_URI=mongodb://127.0.0.1:27017/englishwise

# Authentication - replace with two DIFFERENT strong random secrets in .env
JWT_SECRET=replace_with_a_long_random_jwt_secret
REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# Optional first-admin setup secret; configure only when using this feature
ADMIN_SETUP_KEY=

# AI providers - configure at least one key in your private .env
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional learning models and OpenAI request limits
GEMINI_LEARNING_MODEL=gemini-2.5-flash
OPENAI_LEARNING_MODEL=gpt-4.1-mini
OPENAI_LESSONS_DAILY_PER_USER=3
OPENAI_LESSONS_DAILY_TOTAL=20

# Optional email settings - leave blank unless configured
# For Gmail: EMAIL_SERVICE=gmail and EMAIL_APP_PASSWORD (app password)
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_APP_PASSWORD=

# For SMTP: EMAIL_SERVICE must NOT be gmail; use host, port and password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_PASSWORD=
